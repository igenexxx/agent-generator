# ====================================================================
# Go ADK Agent Generator & Manager Combine Configuration
# ====================================================================

# 1. Gemini / AI Studio API Credentials
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Google Custom Search (Optional Fallback for web_search tool)
# Get key and CX from: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=your_google_custom_search_key_here
GOOGLE_CSE_CX=your_google_custom_search_cx_here

# 3. GitHub MCP & Copilot Integration (Optional)
# Required to access Copilot MCP server: https://api.githubcopilot.com/mcp/
# Create a classic PAT with repo access: https://github.com/settings/tokens
GITHUB_PAT=your_github_pat_here
GITHUB_TOKEN=your_github_pat_here

# 4. Vertex AI Configuration (Optional, set GOOGLE_GENAI_USE_VERTEXAI=1 to enable)
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1
